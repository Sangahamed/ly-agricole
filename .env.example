APP_NAME="LY AGRICOLE"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=fr
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=fr_FR

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Poste de développement : MySQL de XAMPP (démarrer mysqld avant).
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=ly_agricole
DB_USERNAME=root
DB_PASSWORD=

# Production (Vercel + Neon PostgreSQL) : ces valeurs vont dans Vercel → Settings →
# Environment Variables, JAMAIS dans ce fichier ni dans vercel.json (versionnés).
# « Sensitive » à cocher pour APP_KEY, DB_PASSWORD, CRON_SECRET, PUSH_VAPID_PRIVEE.
#   APP_KEY=<php artisan key:generate --show, propre à la production>
#   APP_URL=https://<domaine OVH>
#   DB_CONNECTION=pgsql
#   DB_HOST, DB_DATABASE, DB_USERNAME, DB_PASSWORD (ou les POSTGRES_* de l'intégration
#   Neon, lus en repli ; ou DB_URL). Mot de passe SANS « endpoint=… » : api/index.php
#   pose DB_NEON_ENDPOINT et config/database.php l'ajoute (libpq de Vercel sans SNI).
#   QUEUE_CONNECTION=sync          (pas de queue:work en serverless)
#   CRON_SECRET=<64 caractères hex> (Vercel Cron → /cron/alertes, vercel.json)
#   PUSH_VAPID_PUBLIQUE / PUSH_VAPID_PRIVEE / PUSH_VAPID_SUJET (voir plus bas)
# api/index.php pose aussi APP_ENV=production, APP_DEBUG=false, BROADCAST_CONNECTION=log.
# Migrations sur Neon : depuis le poste, hôte SANS « -pooler », après config:clear,
# php -d extension=pdo_pgsql artisan migrate --force.

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="direction@ylagro.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# Fichiers (justificatifs, reçus, accords, photos). Poste local : local. Production (Vercel,
# disque en lecture seule) : r2 pour les deux, avec le compartiment Cloudflare R2 ci-dessous.
FICHIERS_DISK=local
LIVEWIRE_TMP_DISK=r2

VITE_APP_NAME="${APP_NAME}"

# Confirmations SMS aux producteurs (D10) : journal = écrit dans les logs, rien ne part.
SMS_PILOTE=journal

# Sauvegardes (sem. 12, docs/MISE_EN_PRODUCTION.md). Vide = valeur par défaut.
# Dossier : storage/sauvegardes par défaut ; en production, un autre disque.
SAUVEGARDE_DOSSIER=
# Chemins des outils MySQL si hors du PATH (XAMPP : C:\xampp\mysql\bin\mysqldump.exe).
SAUVEGARDE_MYSQLDUMP=
SAUVEGARDE_MYSQL=
# Défini ⇒ archives chiffrées AES-256 (données personnelles). Garder ce mot de passe
# HORS du serveur : sans lui, aucune restauration possible.
# Le générer avec « php artisan ly:mot-de-passe-sauvegardes » (32 caractères, affiché une fois).
SAUVEGARDE_MOT_DE_PASSE=
SAUVEGARDE_CONSERVER_JOURS=30
# Copie hors site de chaque archive, relue et comparée. L'un OU l'autre :
# un disque de config/filesystems.php (ex. s3 chez l'hébergeur) ...
SAUVEGARDE_HORS_SITE_DISQUE=
# ... ou un dossier hors du serveur (autre disque, \\serveur\partage, dossier synchronisé).
SAUVEGARDE_HORS_SITE_DOSSIER=
SAUVEGARDE_HORS_SITE_CONSERVER_JOURS=90
SAUVEGARDE_BASE_VERIFICATION=ly_agricole_verif

# Notifications push (config/notifications_push.php). Clés : php artisan notifications:cles-vapid
PUSH_VAPID_SUJET=
PUSH_VAPID_PUBLIQUE=
PUSH_VAPID_PRIVEE=
# Téléphones : journal (rien ne part) ou fcm (projet Firebase + compte de service, fichier JSON hors dépôt)
PUSH_FCM_PILOTE=journal
PUSH_FCM_PROJET=
PUSH_FCM_COMPTE_SERVICE=

# Coordonnées publiques affichées sur la vitrine (config/vitrine.php)
VITRINE_EMAIL=direction@ylagro.com
VITRINE_TELEPHONE=0778155878

# Reverb (avis en direct). En local : php artisan reverb:start, puis BROADCAST_CONNECTION=reverb.
# Clés à générer (php artisan reverb:install) — jamais celles du poste de développement.
REVERB_APP_ID=
REVERB_APP_KEY=
REVERB_APP_SECRET=
REVERB_HOST=localhost
REVERB_PORT=8080
REVERB_SCHEME=http

VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST="${REVERB_HOST}"
VITE_REVERB_PORT="${REVERB_PORT}"
VITE_REVERB_SCHEME="${REVERB_SCHEME}"
