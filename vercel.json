{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "npm ci",
  "buildCommand": "npm run build && rm -rf dist && cp -r public dist && rm -f dist/index.php dist/.htaccess dist/hot",
  "outputDirectory": "dist",
  "regions": ["fra1"],
  "functions": {
    "api/index.php": {
      "includeFiles": "storage/**",
      "runtime": "vercel-php@0.9.0",
      "maxDuration": 30
    }
  },
  "crons": [
    {
      "path": "/cron/alertes",
      "schedule": "0 7 * * *"
    }
  ],
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/api/index.php"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=63072000"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        }
      ]
    }
  ]
}